{
  "name": "shiny-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "sql:dev": "sudo service postgres start",
    "sprite-optimize": "cd src/client/static/new-sprites && node --harmony ./sprite-optimize.mjs && rm ./*.gif && cd ../../../..",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && NODE_ENV=production node build/server-bundle.js",
    "start:dev": "export NODE_OPTIONS=--openssl-legacy-provider && rimraf build && webpack --mode=development --config webpack.server.js && concurrently --kill-others \"npm run build:watch\" \"npm run start\"",
    "build": "rimraf build && webpack --mode=production --config webpack.server.js && webpack --mode=production --config webpack.client.js",
    "build:watch": "webpack --progress --mode=development --config webpack.client.js -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "git checkout release && git merge master && git push && git checkout master"
  },
